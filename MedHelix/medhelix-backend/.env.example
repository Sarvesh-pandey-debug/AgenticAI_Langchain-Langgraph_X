# ─────────────────────────────────────────────────────────────────
# MedHelix Backend — Environment Variables Template
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────────
# ⚠️  NEVER commit .env to Git — only commit .env.example

# ── App Settings ──────────────────────────────────────────────────
APP_NAME=MedHelix
APP_ENV=development                         # development | staging | production
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ── Database (PostgreSQL) ─────────────────────────────────────────
# LOCAL (Docker): postgresql+asyncpg://medhelix:medhelix123@localhost:5433/medhelix
# PRODUCTION: Client provides AWS RDS endpoint
DATABASE_URL=postgresql+asyncpg://medhelix:medhelix123@localhost:5433/medhelix
DATABASE_URL_SYNC=postgresql://medhelix:medhelix123@localhost:5433/medhelix

# ── Redis Cache ───────────────────────────────────────────────────
# LOCAL (Docker): redis://localhost:6379
# PRODUCTION: Client provides AWS ElastiCache endpoint
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600

# ── Auth0 (SSO + Multi-Tenant Auth) ──────────────────────────────
# Client provides from: auth0.com → Applications
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_AUDIENCE=https://api.medhelix.com
AUTH0_ALGORITHMS=["RS256"]

# ── AI / LLM ─────────────────────────────────────────────────────
# Client provides from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0

# ── AWS ───────────────────────────────────────────────────────────
# Client provides from: AWS Console → IAM
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=medhelix-documents-dev
AWS_KMS_KEY_ID=your_kms_key_arn

# ── EHR Integrations ─────────────────────────────────────────────
# Client provides EPIC sandbox from: fhir.epic.com
EPIC_CLIENT_ID=your_epic_client_id
EPIC_CLIENT_SECRET=your_epic_client_secret
EPIC_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# Client provides eCW sandbox
ECW_API_KEY=your_ecw_api_key
ECW_BASE_URL=https://your-ecw-sandbox.eclinicalworks.com
ECW_HL7_HOST=your_ecw_hl7_host
ECW_HL7_PORT=2575

# ── Clearinghouse (Stedi) ─────────────────────────────────────────
# Client provides from: stedi.com → API Keys
STEDI_API_KEY=your_stedi_api_key
STEDI_BASE_URL=https://healthcare.us.stedi.com/2024-04-01

# ── Clinical NLP (AWS Comprehend Medical) ─────────────────────────
# Uses same AWS credentials above
COMPREHEND_MEDICAL_REGION=us-east-1

# ── Pagination ────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ── HITL Thresholds ───────────────────────────────────────────────
CODING_CONFIDENCE_THRESHOLD=0.85   # Below this → goes to HITL
AUTO_APPROVE_THRESHOLD=0.95        # Above this → auto approve
